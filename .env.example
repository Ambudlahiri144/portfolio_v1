# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Mail  (required for the contact form and for email verification)
# ---------------------------------------------------------------------------
# Sign up at https://resend.com, then Dashboard -> API Keys -> Create.
# Free tier is 3,000 emails/month, which is far more than a portfolio needs.
RESEND_API_KEY=

# Who the mail appears to be from.
#
# Resend will only send from a domain you have verified with them. Until you
# add one, leave this blank and it falls back to onboarding@resend.dev — that
# works immediately, but it can ONLY deliver to the address your Resend
# account is registered with. Good enough for messages that come to you;
# it will NOT deliver verification codes to visitors, so verify a domain
# before relying on the Hire tab in production.
#
# Once a domain is verified: CONTACT_FROM_EMAIL="Ambud Lahiri <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=

# Overrides where form submissions are delivered. Leave blank in production and
# they go to contactForm.email in src/lib/site.ts.
#
# Useful in local development: until you verify a sending domain, Resend will
# ONLY deliver to the address your Resend account was registered with, so point
# this at that address to test the form end to end.
CONTACT_TO_EMAIL=

# ---------------------------------------------------------------------------
# Verification  (required for the "As an employee" CV gate)
# ---------------------------------------------------------------------------
# Signs the stateless verification token. Any long random string; if this
# leaks, anyone can mint their own "verified" token, so treat it as a secret
# and use a different value in production.
#
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERIFY_SECRET=
